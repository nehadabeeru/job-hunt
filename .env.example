# ---- Backend (docker-compose passes these to the api service) ----
DATABASE_URL=postgresql+psycopg2://jobradar:jobradar@db:5432/jobradar
ENABLE_POLLING=true            # master switch for the background poller
SCHEDULER_TICK_SECONDS=60      # how often the scheduler looks for due companies
DEFAULT_POLL_INTERVAL_SECONDS=180   # per-company default (2–5 min target)
MAX_CONCURRENT_FETCHES=8
HTTP_TIMEOUT_SECONDS=20
FETCH_MAX_RETRIES=3
FETCH_BACKOFF_BASE_SECONDS=2

# ---- Email alerts (Phase 2, optional — leave blank to disable) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# ---- Notion sync (Phase 3, optional) ----
NOTION_TOKEN=
NOTION_DATABASE_ID=
